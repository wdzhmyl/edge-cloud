# 复制为 .env 后填写；全部留空也能运行（自动回退本地模板报告）

# ===== 云端大模型（OpenAI 兼容接口，如移动云/九天大模型）=====
LLM_BASE_URL=https://your-mobilecloud-llm-endpoint/v1
LLM_API_KEY=
LLM_MODEL=your-model-name
LLM_MAX_TOKENS=800

# ===== 本地检测模型（轻量，CPU 可跑）=====
# YOLO26n：NMS-free 端到端，精度优于 YOLOv8n（首次运行自动下载）
DETECTION_MODEL=yolo26n.pt
DETECTION_CONF=0.35
